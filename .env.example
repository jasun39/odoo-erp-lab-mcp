# Skopiuj do .env (cp .env.example .env) i uzupełnij. Plik .env nie trafia do gita
# ani do kontekstu Claude Code — wczytuje go sam serwer MCP (mcp-server-odoo).

# Adres instancji, np. https://twoja-firma.odoo.com (bez końcowego /)
ODOO_URL=

# Nazwa bazy (opcjonalna, gdy lista baz jest publiczna; dla Odoo Online zwykle subdomena)
ODOO_DB=

# Login użytkownika (zwykle e-mail)
ODOO_USER=

# Klucz API: Odoo → Mój profil / Preferencje → Bezpieczeństwo konta → Nowy klucz API
ODOO_API_KEY=

# Alternatywnie hasło (gorsze rozwiązanie; zostaw puste, jeśli używasz klucza API)
ODOO_PASSWORD=

# Tryb bez modułu MCP po stronie Odoo:
#   read  — tylko odczyt (bezpieczny start)
#   true  — pełny dostęp: create/update/delete
ODOO_YOLO=read

# Wywołania metod biznesowych (np. action_confirm) — działa tylko z ODOO_YOLO=true
ODOO_MCP_ENABLE_METHOD_CALLS=false

# Transport do Odoo: auto (domyślnie; JSON-2 dla Odoo 19+ z kluczem API),
# xmlrpc (Odoo 16–18) lub json2
# ODOO_RPC_TRANSPORT=auto

ODOO_LOCALE=pl_PL
